# Generated artifacts: the files the API reads and the thesis evidence are committed;
# runtime state (artifacts/state) and quick runs (artifacts/quick) are not.
artifacts/**
!artifacts/manifest.json
!artifacts/pipeline.json
!artifacts/calibration.json
!artifacts/predictions/
!artifacts/predictions/validation.csv.gz
!artifacts/predictions/test.csv.gz
!artifacts/metrics.json
!artifacts/feature_importance.csv
!artifacts/best_params.json
!artifacts/tuning.json
!artifacts/learning_curves.json
!artifacts/resampling.json
!artifacts/preprocessing_log.json
!artifacts/significance.json
!artifacts/ablation.json
!artifacts/data_quality.json
# Extension studies (scripts/resampling_study.py, robustness.py, literature_metrics.py,
# history_length.py, deep_baseline.py)
!artifacts/resampling_study.json
!artifacts/robustness.json
!artifacts/literature_metrics.json
!artifacts/history_length.json
!artifacts/deep_baseline.json
!artifacts/hybrid_study.json
!artifacts/sequence.json
!artifacts/predictions/extensions_validation.csv.gz
!artifacts/predictions/extensions_test.csv.gz

