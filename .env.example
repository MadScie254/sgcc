ENV=development
# Required when ENV is not development: a JSON list of named keys. Create each with
#   python scripts/make_api_key.py <name> <analyst|supervisor>
# and give the printed key to that person; only its SHA-256 goes here.
# API_KEYS=[{"name": "admin", "role": "supervisor", "sha256": "the-hash-printed-by-make_api_key"}]
# PostgreSQL for cases, runs, settings and the audit log (unset: SQLite in SGCC_STATE_DIR).
# python scripts/setup_database.py creates the role and databases and writes both lines.
DATABASE_URL=
# The database pytest uses; never the one above (unset: a temporary SQLite database).
TEST_DATABASE_URL=
# S3-compatible object storage for uploads and PDF reports (unset: a local folder).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Uploads and reports older than this many days are deleted (0 keeps them).
RETENTION_DAYS=90
# Requests per minute per key.
RATE_LIMIT_PER_MINUTE=600
# Minutes between automatic scoring runs (0 = only at startup).
SCORING_INTERVAL_MINUTES=0
# Largest accepted upload in MB.
MAX_UPLOAD_MB=25
